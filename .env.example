# Kernos configuration. Copy to .env (git-ignored) or export in the service
# environment. Nothing in this file is required for a local run with the mock
# model provider; every value has a safe default.

# ---------------------------------------------------------------- kernel ----
KERNOS_LISTEN=127.0.0.1:7401
KERNOS_DATA=./kernos-data
# Shared bearer token for workers and the gateway. Leave empty for a loopback-only
# development server; set it for anything reachable from another machine.
KERNOS_TOKEN=
KERNOS_LEASE_TTL=30
KERNOS_SWEEP_MS=1000
KERNOS_APPROVAL_SWEEP_MS=5000
KERNOS_BUDGET_SOFT_RATIO=0.8
KERNOS_MAX_ATTEMPTS=5
KERNOS_MAX_DET_ATTEMPTS=3
KERNOS_LOG=text

# --------------------------------------------------------------- gateway ----
KERNOS_GATEWAY_LISTEN=127.0.0.1:7402
KERNOS_GATEWAY_DATA=./gateway-data
KERNOS_KERNEL_URL=http://127.0.0.1:7401
# Pin the control-plane public key instead of fetching it from the kernel.
KERNOS_PUBLIC_KEY=
KERNOS_CANARY_INTERVAL=60
KERNOS_CANARY_QUARANTINE_AFTER=2
KERNOS_CANARY_AUTO_RELEASE=0
# Test-only connectors (test.slow, test.flaky, test.fail). Never in production.
KERNOS_GATEWAY_TEST_TOOLS=0
# Connector credentials are referenced from gateway.json as ${NAME} and are
# substituted at load time; they never appear in logs, events or responses.
# CRM_TOKEN=
# HALCYON_LEDGER_DB=./halcyon-ledger.db

# ---------------------------------------------------------------- worker ----
KERNOS_KERNEL_URL=http://127.0.0.1:7401
KERNOS_GATEWAY_URL=http://127.0.0.1:7402
# mock (no network, deterministic) or anthropic
KERNOS_PROVIDER=mock
ANTHROPIC_API_KEY=
KERNOS_MODEL_DEEP=claude-opus-5
KERNOS_MODEL_STANDARD=claude-sonnet-5
KERNOS_MODEL_CHEAP=claude-haiku-4-5-20251001
# Path to a JSON price table to override the built-in one.
KERNOS_PRICING_JSON=

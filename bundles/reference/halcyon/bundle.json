            ],
            "properties": {
              "account": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "escalate": {
            "when_confidence_below": 0.7,
            "to_tier": "standard"
          }

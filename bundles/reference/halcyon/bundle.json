            }
          }
        },
        {
          "id": "boom",
          "kind": "tool",
          "tool": "test.fail",
          "description": "Acceptance fixture: a tool call that always fails deterministically.",
          "args": {}
        }
      ]
    },
    "http_first": {
      "description": "Fetches probe_url through the http connector first, then runs intake without the payment action (acceptance scenarios A5 and A8).",
      "input_schema": {
        "type": "object",
        "required": [
          "invoice_id",
          "text",
          "total"
        ],
        "properties": {
          "invoice_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "total": {
            "type": "number",
            "minimum": 0
          },
          "accounts": {
            "type": "array",

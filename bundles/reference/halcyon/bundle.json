            "properties": {
              "vendor": {
                "type": "string"
              },
              "invoice_id": {
                "type": "string"
              },
              "total": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "on_refusal": "park",
          "max_output_tokens": 1024
        },
        {
          "id": "code",
          "kind": "model",
          "tier": "cheap",

              "type": "string"
            }
          },
          "probe_url": {
            "type": "string"
          }
        }
      },
      "steps": [
        {
          "id": "fetch",
          "kind": "tool",
          "tool": "http.get",
          "description": "Fetch a document from an upstream service before extraction.",
          "args": {
            "url": "{{input.probe_url}}"
          }
        },
        {
          "id": "extract",
          "kind": "model",
          "tier": "standard",
          "effort": "low",
          "prompt": "extract",
          "description": "Read the vendor, invoice number, total and currency out of the invoice text.",
          "output_schema": {
            "type": "object",
